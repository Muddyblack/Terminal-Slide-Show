def write_fleet(fleet, answers, vault_password_file):
    fleet.mkdir(parents=True, exist_ok=True)
    (fleet / "group_vars" / "slideshow").mkdir(parents=True)
    (fleet / "host_vars").mkdir()

    hosts = "\n".join(f"        {name}:\n          ansible_host: {name}.local" for name in answers["devices"])
    (fleet / "inventory.yml").write_text(
        "---\n# Your devices. Replace <name>.local by the IP address if the name is not found on your network.\n"
        f"all:\n  children:\n    slideshow:\n      hosts:\n{hosts}\n")

    (fleet / "ansible.cfg").write_text(
        "[defaults]\n"
        "inventory = inventory.yml\n"
        "display_args_to_stdout = false\n"
        "interpreter_python = auto_silent\n"
        f"vault_password_file = {vault_password_file}\n\n"
        "[ssh_connection]\n"
        "pipelining = true\n"
        "# Trust a device's key the first time you connect, refuse it if it ever changes\n"
        "ssh_args = -o StrictHostKeyChecking=accept-new\n")

    (fleet / "requirements.yml").write_text(
        "---\ncollections:\n"
        "  - name: https://github.com/Muddyblack/Terminal-Slide-Show.git#/ansible\n"
        "    type: git\n"
        f"    version: {'v' + answers['version'] if answers['release_found'] else 'main'}\n"
        "  - name: ansible.posix\n")

    schedule = {"enabled": True, "onTime": answers["on_time"], "offTime": answers["off_time"],
                "days": answers["days"], "vacationPeriods": []}
    main = [
        "---",
        "# Settings for every device. Per-device values are in host_vars/.",
        f"slideshow_version: {q(answers['version'])}",
        f"slideshow_release_sha256: {q(answers['sha256'])}",
        "",
        f"slideshow_admin_user: {q(answers['admin'])}",
        f"slideshow_admin_ssh_keys:\n  - {q(answers['ssh_key'])}",
        f"slideshow_ssh_allowed_cidrs: {json.dumps(answers['ssh_net'])}",
        "",
        f"slideshow_timezone: {q(answers['timezone'])}",
        f"slideshow_location: {q(answers['location'])}",
        f"slideshow_google_folder_id: {q(answers['folder'])}",
        "",
        "slideshow_settings:",
        f"  schedule: {json.dumps(schedule)}",
        f"  locale: {json.dumps({'language': answers['display_language'], 'units': 'metric'})}",
        "",
        "slideshow_updates: security",
        f"slideshow_daily_reboot: {q('04:15' if answers['reboot'] else '')}",
    ]
    if answers["wifi"]:
        main += ["", "# Only used when preparing the SD card",
                 "slideshow_wifi:",
                 f"  ssid: {q(answers['wifi']['ssid'])}",
                 '  password: "{{ vault_wifi_password }}"',
                 f"  country: {q(answers['wifi']['country'])}"]
    (fleet / "group_vars" / "slideshow" / "main.yml").write_text("\n".join(main) + "\n")

    for name, mode in answers["devices"].items():
        (fleet / "host_vars" / f"{name}.yml").write_text(f"---\nslideshow_display_mode: {mode}\n")

    vault = ["---", f"slideshow_google_service_account: {q(answers['service_account'])}"]
    if answers["nasa"]:
        vault.append(f"slideshow_nasa_api_key: {q(answers['nasa'])}")
    if answers["wifi"]:
        vault.append(f"vault_wifi_password: {q(answers['wifi']['password'])}")
    vault_file = fleet / "group_vars" / "slideshow" / "vault.yml"
    vault_file.write_text("\n".join(vault) + "\n")
    vault_file.chmod(0o600)
    run_tool(["ansible-vault", "encrypt", "--vault-password-file", str(vault_password_file), str(vault_file)],
             stdout=subprocess.DEVNULL)

    (fleet / ".gitignore").write_text("*.img\n.ansible/\n")


def ensure_vault_password(wizard):
    if VAULT_PASSWORD_FILE.exists():
        print(wizard.t("vault_reuse", path=VAULT_PASSWORD_FILE))
        return
    VAULT_PASSWORD_FILE.parent.mkdir(parents=True, exist_ok=True)
    VAULT_PASSWORD_FILE.write_text(secrets.token_urlsafe(32) + "\n")
    VAULT_PASSWORD_FILE.chmod(0o600)
    print(wizard.t("vault_new", path=VAULT_PASSWORD_FILE))


