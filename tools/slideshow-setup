class Cancel(Exception):
    pass


class Wizard:
    def __init__(self, lang):
        self.lang = lang

    def t(self, key, **values):
        return TEXT[self.lang][key].format(**values)

    def ask(self, key, default=None, check=None, secret=False, optional=False, **values):
        question = self.t(key, **values)
        hint = f" [{default}]" if default else ""
        while True:
            reader = getpass.getpass if secret else input
            answer = reader(f"{question}{hint}: ").strip()
            if not answer:
                if default is not None:
                    answer = default
                elif optional:
                    return ""
                else:
                    continue
            if check:
                problem = check(answer)
                if problem:
                    print(problem)
                    continue
            return answer

    def yes(self, key, default=True, **values):
        suffix = f" {self.t('yn')} [{self.t('yes') if default else self.t('no')}]"
        while True:
            answer = input(self.t(key, **values) + suffix + ": ").strip().lower()
            if not answer:
                return default
            if answer[0] in (self.t("yes"), "y", "j"):
                return True
            if answer[0] == self.t("no"):
                return False


