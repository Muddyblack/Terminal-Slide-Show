def check_time(wizard):
    return lambda value: None if re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", value) else wizard.t("bad_time")


def check_timezone(wizard):
    def check(value):
        try:
            ZoneInfo(value)
        except (ZoneInfoNotFoundError, ValueError):
            return wizard.t("bad_timezone")
    return check


def check_network(wizard):
    def check(value):
        try:
            ipaddress.ip_network(value, strict=False)
        except ValueError:
            return wizard.t("bad_net")
    return check


def find_ssh_key():
    for name in ("id_ed25519.pub", "id_ecdsa.pub", "id_rsa.pub"):
        path = Path.home() / ".ssh" / name
        if path.exists():
            return path
    return None


def make_ssh_key():
    key = Path.home() / ".ssh" / "id_ed25519"
    key.parent.mkdir(mode=0o700, exist_ok=True)
    subprocess.run(["ssh-keygen", "-t", "ed25519", "-f", str(key), "-C", "slideshow-admin"], check=True)
    return Path(str(key) + ".pub")


def read_service_account(path):
    """Returns (raw JSON text, e-mail) or raises ValueError with a readable reason."""
    try:
        raw = Path(path).expanduser().read_text()
        data = json.loads(raw)
    except (OSError, ValueError) as error:
        raise ValueError(str(error))
    if data.get("type") != "service_account" or not data.get("client_email") or not data.get("private_key"):
        raise ValueError('"type", "client_email" and "private_key" are required')
    return raw.strip(), data["client_email"]


def release_with_tarball(release):
    """(version, sha256 URL) if the release ships the tarball and its checksum, else None.

    Older releases of the project have no tarball, so they must not be offered."""
    version = release["tag_name"].lstrip("v")
    names = {asset["name"]: asset["browser_download_url"] for asset in release.get("assets", [])}
    tarball = f"terminal-slide-show-{version}.tar.gz"
    if tarball in names and tarball + ".sha256" in names:
        return version, names[tarball + ".sha256"]
    return None


def latest_release():
    """(version, sha256) of the newest release that can be installed, or (None, None)."""
    try:
        request = urllib.request.Request(RELEASES_API, headers={"User-Agent": "slideshow-setup"})
        with urllib.request.urlopen(request, timeout=15) as response:
            found = release_with_tarball(json.load(response))
        if not found:
            return None, None
        version, checksum_url = found
        with urllib.request.urlopen(checksum_url, timeout=15) as response:
            return version, response.read().decode().split()[0].lower()
    except (OSError, ValueError, KeyError):
        return None, None


def q(value):
    """A YAML-safe quoted scalar (JSON strings are valid YAML)."""
    return json.dumps(value, ensure_ascii=False)


def run_tool(command, **kwargs):
    try:
        return subprocess.run(command, check=True, **kwargs)
    except FileNotFoundError:
        raise SystemExit(f"{command[0]} not found")


